# macOS
.DS_Store

# Editor backups
*~
*.swp

# C build outputs
c/*.o
c/*.a
c/*.dylib
c/*.so
c/shavar
c/shavar-shared
c/*.plist

# Lean build outputs
lean/.lake/

# LaTeX intermediates. The .tex and refs.bib are source; shavar.pdf is a
# tested build output and IS committed so the document can be read without
# a TeX installation.
doc/*.aux
doc/*.log
doc/*.out
doc/*.toc
doc/*.bbl
doc/*.bcf
doc/*.blg
doc/*.fls
doc/*.fdb_latexmk
doc/*.run.xml
doc/*.synctex.gz

# CWEB. shavar-cweb.w is the source; everything ctangle and cweave derive from
# it is a build output. In particular the tangled C files here are regenerated
# on every build -- edit the .w, never these. shavar-cweb.pdf is a tested
# artefact and IS committed, on the same reasoning as doc/shavar.pdf.
cweb/shavar-cweb.c
cweb/shavar.h
cweb/main.c
cweb/shavar
cweb/shavar-cweb.tex
cweb/shavar-cweb.idx
cweb/shavar-cweb.scn
cweb/shavar-cweb.toc
cweb/shavar-cweb.log
cweb/shavar-cweb.lbl
cweb/shavar-cweb.pgf

# broken/ build outputs
broken/lean/.lake/
broken/c/sha01
broken/attack/expansion
broken/attack/collide
broken/*.aux
broken/*.bbl
broken/*.bcf
broken/*.blg
broken/*.log
broken/*.out
broken/*.run.xml
broken/*.toc
broken/*.fdb_latexmk
broken/*.fls
