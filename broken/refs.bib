% Bibliography for broken/sha-broken.tex.
%
% Per the project convention, every entry records whether a local copy exists
% in refs/ and, if so, its path and retrieval date. Entries without a local
% copy say so explicitly rather than leaving the reader to find out.
%
% Nothing here was cited without opening it first. The retrieved PDFs were
% checked against their own title pages before being used; the project log
% records an earlier occasion on which a guessed download turned out to be an
% unrelated paper, which is why that step is written down.
%
% Note on malware screening: the project convention asks for a VirusTotal
% check on retrieved files. No API access was available in this environment,
% so what was actually done is stated plainly instead: each file was confirmed
% to be a well-formed PDF by MIME type, its first page was extracted as text
% and matched against the expected title and authors, and it was retrieved
% over TLS from the publisher, the authors' own site, or the Internet Archive.
% That is weaker than a scan and is recorded as such.

@inproceedings{chabaud1998,
  author    = {Chabaud, Florent and Joux, Antoine},
  title     = {Differential Collisions in {SHA-0}},
  booktitle = {Advances in Cryptology --- CRYPTO '98},
  series    = {Lecture Notes in Computer Science},
  volume    = {1462},
  pages     = {56--71},
  publisher = {Springer},
  year      = {1998},
  doi       = {10.1007/BFb0055720},
  note      = {Local copy: \path{refs/chabaud-joux-1998.pdf}, retrieved
               2026-08-10 via the Internet Archive's copy of the publisher
               PDF. Identity confirmed from the title page. This is the paper
               that introduced local collisions and disturbance vectors, and
               its abstract already records that the same method fails against
               SHA-1 --- the earliest statement of the point this directory
               demonstrates by measurement.},
}

@techreport{fips180,
  author      = {{National Institute of Standards and Technology}},
  title       = {Secure Hash Standard},
  number      = {FIPS PUB 180},
  institution = {U.S. Department of Commerce},
  year        = {1993},
  month       = {5},
  note        = {The original SHA, retrospectively called SHA-0. Withdrawn in
                 1995. \textbf{No local copy}: NIST does not serve the
                 withdrawn 1993 publication, and no authoritative PDF was
                 located. The algorithm as implemented here is FIPS 180-1
                 with the expansion rotation removed, which is the documented
                 relationship between the two.},
}

@techreport{fips180-1,
  author      = {{National Institute of Standards and Technology}},
  title       = {Secure Hash Standard},
  number      = {FIPS PUB 180-1},
  institution = {U.S. Department of Commerce},
  year        = {1995},
  month       = {4},
  url         = {https://csrc.nist.gov/pubs/fips/180-1/final},
  note        = {SHA-1: FIPS 180 plus a one-bit rotation in the message
                 expansion. \textbf{No local copy}: the archived PDF returned
                 404 from every NIST path tried on 2026-08-10. The superseding
                 FIPS 180-4 \cite{fips180-4} is mirrored in \path{refs/} and
                 specifies SHA-1 identically.},
}

@techreport{fips180-4,
  author      = {{National Institute of Standards and Technology}},
  title       = {Secure Hash Standard (SHS)},
  number      = {FIPS PUB 180-4},
  institution = {U.S. Department of Commerce},
  year        = {2015},
  doi         = {10.6028/NIST.FIPS.180-4},
  note        = {Local copy: \path{refs/fips180-4.pdf}, retrieved 2026-08-09.
                 Carries the current normative text of SHA-1 as well as the
                 SHA-2 family.},
}

@inproceedings{joux2004,
  author    = {Biham, Eli and Chabaud, Florent and Joux, Antoine},
  title     = {Collisions of {SHA-0}},
  booktitle = {Announcement at CRYPTO 2004 rump session},
  year      = {2004},
  note      = {The first actual SHA-0 collision, found by Joux with
               Carribault, Lemuet and Jalby on a 256-CPU machine.
